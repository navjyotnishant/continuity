.orion/

# OS cruft
.DS_Store

# Python cruft — no build step, but the interpreter still leaves this behind
__pycache__/
*.pyc

# Secret-bearing local config (OSPS-BR-07.01) — Continuity itself has no
# .env/credentials of its own, but a plugin installed into a project must
# never pick these up.
.env
.env.*
*.pem
*.key

# This repo's own Continuity store holds one developer's working notes about
# building the plugin, so it opts out of git tracking (docs/install.md). The
# plugin's default for other projects is still to track it.
.continuity/
